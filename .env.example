# Modelo do .env. Copie para `.env` e preencha.
# O .env real está no .gitignore e nunca vai para o repositório.
# Em produção, estas variáveis são cadastradas no painel do Coolify.

# --- Telegram ---------------------------------------------------------------
TELEGRAM_TOKEN=
# Precisa ser SUPERGRUPO (id começando com -100). Em grupo básico o link de cada
# demanda no painel não existe, e o id muda sozinho quando o grupo converter.
TELEGRAM_CHAT_ID=
# Privado de quem mantém o bot. Recebe ALERTA DE OPERAÇÃO — sessão do Facebook
# expirada, fonte quebrada. Nunca recebe demanda. Deixar vazio faz o aviso de
# sessão morta ficar só no log, e sessão morta é a falha silenciosa deste bot.
REPORT_CHAT_IDS=

# --- Classificador ----------------------------------------------------------
# Gerar em https://aistudio.google.com/apikey — criando um PROJETO próprio para
# este cliente. O teto diário do free tier é por projeto: reaproveitar a chave
# de outro bot faz os dois disputarem a mesma cota e um derrubar o outro.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Fontes -----------------------------------------------------------------
SOURCES=facebook
INTERVAL_FACEBOOK=1800
# Sessão do navegador, criada por `python bot/tools/facebook_login.py`.
# Vazio = <DATA_DIR>/fb_state.json
FACEBOOK_STATE_FILE=
# A MESMA sessão, em base64 — é assim que ela chega no SERVIDOR. O bot escreve
# o arquivo no volume no boot, então não é preciso copiar nada para dentro do
# container. Gerar com `python bot/tools/sessao_para_env.py`; local pode ficar
# vazio, porque aí o arquivo já está na pasta.
#
# O bot só sobrescreve a sessão do volume quando ESTE valor muda: ele mesmo
# renova os cookies a cada ciclo, e reescrever a cada boot devolveria uma
# sessão velha e derrubaria a conta.
FACEBOOK_STATE_B64=
# Pasta do perfil do Chromium. Em producao vem do compose (/app/data/...). Com
# perfil, o navegador que logou e o que coleta sao o mesmo aparelho — e o
# Facebook para de pedir confirmacao a cada ciclo.
FACEBOOK_PROFILE_DIR=
# CREDENCIAL PARA O BOT REFAZER O LOGIN SOZINHO quando a sessão cair.
# A sessão precisa nascer no servidor: uma criada noutra máquina chega ao
# Facebook como aparelho novo em lugar novo e cai em checkpoint — e continua
# válida na máquina de origem, o que faz parecer que está tudo certo.
FB_EMAIL=
FB_PASSWORD=
# Segredo do autenticador, em base32. COM ele a renovação é 100% automática.
# Sem ele o bot pede o código no privado de REPORT_CHAT_IDS e espera a resposta.
FB_TOTP_SECRET=
RELOGIN_AUTOMATICO=true
# Quanto tempo esperar o código chegar pelo Telegram (segundos).
RELOGIN_ESPERA_CODIGO_S=600
# Piso entre duas tentativas de login. Insistir em cima de checkpoint aberto é
# o caminho mais rápido para perder a conta.
RELOGIN_INTERVALO_H=6
# Sempre true em produção: não há tela no servidor.
FACEBOOK_HEADLESS=true
FACEBOOK_MAX_POSTS=25
FACEBOOK_SCROLLS=4
# Só o tools/facebook_login.py usa isto, e só para preencher o formulário na
# janela do navegador durante a criação da sessão. NÃO cadastrar em produção:
# o bot lê a sessão (fb_state.json), nunca a senha.
FB_EMAIL=
FB_PASSWORD=

# --- Operação ---------------------------------------------------------------
CHECK_INTERVAL=600
DATA_DIR=.
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo
REPORT_HOUR=22
REPORT_TO=grupo

# --- Volume -----------------------------------------------------------------
# 0 = SEM TETO. O painel sobrescreve sem redeploy.
DAILY_LIMIT=0
SEND_WINDOW_START=6
SEND_WINDOW_END=23
QUEUE_TTL_DAYS=3
# Nota mínima (0-100) para entrar na fila. 0 = sem piso.
MIN_SCORE=0

# --- Post removido do Facebook ----------------------------------------------
# Quando o post some (autor apagou, moderador removeu, grupo fechou), a mensagem
# no grupo é riscada com um aviso de encerrada.
# "marcar" (padrão) | "apagar" (a mensagem some) | "nada" (desliga a revisão).
# São necessárias DUAS confirmações seguidas antes de qualquer mudança, e a
# segunda vem em 1h — a primeira, no ciclo seguinte à publicação.
ACAO_VAGA_ENCERRADA=marcar
RECHECK_HORAS=24
RECHECK_POR_CICLO=8
RECHECK_DIAS=30

# --- Regras de corte --------------------------------------------------------
# Advogado se anunciando não é oportunidade, é concorrência. É o ruído
# dominante em grupo de advogado e o filtro que sustenta o produto.
REJEITAR_DIVULGACAO=true
# UFs atendidas. Só valem quando a demanda EXIGE presença física — trabalho
# digital passa em qualquer estado. Vazio = aceita qualquer UF, e é o padrão:
# os grupos lidos são nacionais e o escritório é 100% digital.
UFS_ATENDIDAS=
# Post presencial que não diz onde é: aceitar? Em grupo regional é comum não
# dizer a comarca, então o padrão é sim.
ACEITAR_SEM_LOCAL=true
REJECT_ENGLISH=true

# --- Apresentação do bot no privado -----------------------------------------
SITE_URL=https://www.milenarezner.com.br
INSTAGRAM_URL=https://instagram.com/advmilenarezner
SUPORTE_TELEGRAM=

# --- Painel -----------------------------------------------------------------
# Vazio = o bot roda igual, só não alimenta o dashboard.
DATABASE_URL=
# Só usados pelo docker-compose:
POSTGRES_PASSWORD=
AUTH_SECRET=
# Domínio do painel. Sem ele o Traefik não cria rota alcançável de fora.
ADMIN_DOMAIN=admin.milenarezner.com.br
# Primeiro usuário do painel, criado no boot se ainda não existir. Depois disso
# a variável pode ficar: ela nunca sobrescreve a senha de quem já existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
